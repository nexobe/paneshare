<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not sandboxed: posting CGEvents to other apps and AX window control are not available to
  sandboxed apps. Release builds (scripts/release.sh) add the hardened runtime; under it, audio
  input needs the audio-input entitlement, which the app-audio process tap may count as. It is
  harmless for ad hoc builds. Library validation stays on: Sparkle is signed by the same team.
  A later build may add keychain-access-groups (needs a provisioning profile) for the
  data-protection keychain.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
